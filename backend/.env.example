APP_ENV=development
PORT=8085
LOG_LEVEL=debug
DATABASE_URL=postgres://sbts:sbts@localhost:5433/sbts?sslmode=disable
REDIS_URL=redis://localhost:6379/0
CORS_ORIGINS=http://localhost:5180
SHUTDOWN_TIMEOUT=10s

# Auth
JWT_SECRET=change-me-to-a-random-string-of-at-least-32-chars
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h
OTP_TTL=5m
# Dev only: every OTP sent is this code, so the mobile team can log in without SMS. Never set in production.
OTP_DEV_CODE=123456
# Super Admin must enable an authenticator app (2FA). Forced on in production; off here for easy local testing.
REQUIRE_SUPER_ADMIN_2FA=false
