!frontend/package-lock.json
!frontend/index.html
!frontend/public/**
!frontend/src/**
!frontend/tsconfig.json
!frontend/tsconfig.app.json
!frontend/tsconfig.node.json
!frontend/vite.config.ts
!deploy/nginx/templates/**
!deploy/nginx/snippets/**
