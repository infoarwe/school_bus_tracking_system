# School Bus Tracking behind the host's own Nginx (a server shared with other sites).
# The host Nginx terminates HTTPS and forwards to this container on 127.0.0.1 over HTTP;
# see deploy/docker-compose.proxied.yml and deploy/host-nginx/. Otherwise the same as
# templates/sbts.conf.template.

log_format sbts '$remote_addr [$time_local] "$request_method $uri $server_protocol" '
                '$status $body_bytes_sent $request_time "$http_user_agent"';

# The client IP comes from the host Nginx (it overwrites X-Real-IP). Only trust it from
# private addresses: the port is published on 127.0.0.1 only, so the peer is Docker's gateway.
set_real_ip_from 10.0.0.0/8;
set_real_ip_from 172.16.0.0/12;
set_real_ip_from 192.168.0.0/16;
set_real_ip_from 127.0.0.1;
real_ip_header X-Real-IP;

limit_req_zone $binary_remote_addr zone=sbts_api:10m rate=${NGINX_API_RATE};

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

upstream sbts_api {
    server api:8085;
    keepalive 32;
}

server_tokens off;

server {
    listen 80;
    server_name ${SERVER_NAME};
    access_log /var/log/nginx/access.log sbts;

    client_max_body_size 12m;

    gzip on;
    gzip_types application/json application/javascript text/css image/svg+xml application/yaml;

    location = /api/v1/ws {
        include /etc/nginx/snippets/security-headers.conf;
        include /etc/nginx/snippets/proxy-headers.conf;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_read_timeout 120s;
        proxy_send_timeout 120s;
        proxy_buffering off;
        proxy_pass http://sbts_api;
    }

    location /api/ {
        include /etc/nginx/snippets/security-headers.conf;
        include /etc/nginx/snippets/proxy-headers.conf;
        proxy_set_header Connection "";
        limit_req zone=sbts_api burst=${NGINX_API_BURST} nodelay;
        limit_req_status 429;
        proxy_read_timeout 120s;
        proxy_pass http://sbts_api;
    }

    location ~ ^/(health|docs|openapi\.yaml)$ {
        include /etc/nginx/snippets/security-headers.conf;
        include /etc/nginx/snippets/proxy-headers.conf;
        proxy_set_header Connection "";
        proxy_pass http://sbts_api;
    }

    root /usr/share/nginx/html;

    location /assets/ {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        try_files $uri =404;
    }

    location / {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "no-cache" always;
        add_header Content-Security-Policy "object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'" always;
        add_header Content-Security-Policy-Report-Only "default-src 'self'; script-src 'self' https://maps.googleapis.com https://*.gstatic.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' data: blob: https://*.googleapis.com https://*.gstatic.com https://*.google.com https://*.ggpht.com; font-src 'self' data: https://fonts.gstatic.com; connect-src 'self' wss://${SERVER_NAME} https://*.googleapis.com https://*.google.com https://*.gstatic.com; worker-src blob:; frame-src https://*.google.com; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'" always;
        try_files $uri /index.html;
    }
}
