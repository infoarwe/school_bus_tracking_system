# Copy to deploy/.env on the server and fill in every value. deploy/.env is git-ignored:
# never commit it. Generate secrets ON THE SERVER, for example:  openssl rand -hex 32
# Back up this file somewhere safe and separate (see README "Backups"): without
# DATA_ENCRYPTION_KEY the stored Maps and Firebase keys cannot be decrypted.

# Public hostname (DNS A/AAAA record pointing at this server). Admin web: https://SERVER_NAME,
# API for the mobile team: https://SERVER_NAME/api/v1, docs: https://SERVER_NAME/docs
SERVER_NAME=dev.example.com

# development | staging | production. The shared dev server uses "staging" (allows OTP_DEV_CODE
# and demo seed data); "production" refuses both.
APP_ENV=staging
LOG_LEVEL=info

# Hex only (no URL-special characters): openssl rand -hex 24
POSTGRES_PASSWORD=
REDIS_PASSWORD=
# At least 32 characters: openssl rand -hex 32
JWT_SECRET=
# Exactly 64 hex characters: openssl rand -hex 32. Never change it once data exists.
DATA_ENCRYPTION_KEY=

# Shared dev server only: every OTP is this code so the mobile team can log in without SMS.
# Leave EMPTY on production (the API refuses to start in production with it set).
OTP_DEV_CODE=
REQUIRE_SUPER_ADMIN_2FA=true

# Optional overrides (defaults shown)
# UPLOAD_MAX_LOGO_BYTES=1048576
# RATE_LIMIT_IP_PER_MINUTE=1200
# RATE_LIMIT_USER_PER_MINUTE=600
# RATE_LIMIT_AUTH_PER_15_MINUTES=60
# RATE_LIMIT_OTP_SEND_PER_HOUR=20
# Nginx per-IP limit on /api/ (first line of defence; raise only for a single-machine load test)
# NGINX_API_RATE=30r/s
# NGINX_API_BURST=60
# HTTP_PORT=80
# HTTPS_PORT=443
# CERTS_DIR=/etc/letsencrypt
# ACME_WEBROOT=/var/www/certbot
# SBTS_VERSION=latest
